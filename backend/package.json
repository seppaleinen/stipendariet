{
  "name": "@stipendariet/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "lint": "(venv/bin/ruff check . || python3 -m ruff check .)",
    "format:check": "(venv/bin/ruff format --check . || python3 -m ruff format --check .)",
    "format:fix": "(venv/bin/ruff format . || python3 -m ruff format .)",
    "test": "(venv/bin/pytest . || python3 -m pytest .)"
  }
}
